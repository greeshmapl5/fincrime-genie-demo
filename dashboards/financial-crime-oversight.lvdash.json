{
  "datasets": [
    {
      "name": "01ed5764",
      "displayName": "kpis",
      "queryLines": [
        "SELECT COUNT_IF(status = 'Open') AS open_alerts,\r\n",
        "       COUNT_IF(status = 'Open' AND risk_score >= 0.8) AS high_priority_open,\r\n",
        "       COUNT_IF(status = 'Escalated') AS escalated,\r\n",
        "       COUNT_IF(status = 'Closed - false positive') AS closed_false_positive,\r\n",
        "       (SELECT COUNT(*) FROM fincrime.gold.structuring_candidates) AS structuring_candidates\r\n",
        "FROM fincrime.gold.alerts"
      ]
    },
    {
      "name": "ed91bf46",
      "displayName": "alerts_by_typology_status",
      "queryLines": [
        "SELECT typology, status, COUNT(*) AS alert_count\r\n",
        "FROM fincrime.gold.alerts\r\n",
        "GROUP BY typology, status"
      ]
    },
    {
      "name": "5c3d592b",
      "displayName": "escalation_rate_by_typology",
      "queryLines": [
        "SELECT typology,\r\n",
        "       COUNT_IF(status = 'Escalated') AS escalated,\r\n",
        "       COUNT_IF(status = 'Closed - false positive') AS closed_false_positive,\r\n",
        "       ROUND(COUNT_IF(status = 'Escalated') / NULLIF(COUNT_IF(status != 'Open'), 0), 2) AS escalation_rate\r\n",
        "FROM fincrime.gold.alerts\r\n",
        "GROUP BY typology"
      ]
    },
    {
      "name": "83b961ed",
      "displayName": "open_queue",
      "queryLines": [
        "SELECT a.alert_id, a.customer_id, c.segment, c.sector, a.typology, a.risk_score, a.alert_date,\r\n",
        "       DATEDIFF(CAST(d.as_of_ts AS DATE), a.alert_date) AS age_days\r\n",
        "FROM fincrime.gold.alerts a\r\n",
        "JOIN fincrime.gold.customer_360 c ON a.customer_id = c.customer_id\r\n",
        "CROSS JOIN fincrime.gold.data_as_of d\r\n",
        "WHERE a.status = 'Open'\r\n",
        "ORDER BY a.risk_score DESC"
      ]
    },
    {
      "name": "2c644386",
      "displayName": "candidate_concentration",
      "queryLines": [
        "SELECT customer_id, sector, account_age_days, near_threshold_deposits, outflow_to_inflow_ratio,\r\n",
        "       top_onward_counterparty, top_onward_counterparty_share, open_alert_id\r\n",
        "FROM fincrime.gold.structuring_candidates\r\n",
        "ORDER BY top_onward_counterparty_share DESC"
      ]
    },
    {
      "name": "af744fc1",
      "displayName": "decisions_per_week",
      "queryLines": [
        "SELECT DATE_TRUNC('week', decided_at) AS week, status, COUNT(*) AS decisions\r\n",
        "FROM fincrime.gold.alerts\r\n",
        "WHERE status != 'Open'\r\n",
        "GROUP BY 1, 2\r\n",
        "ORDER BY 1"
      ]
    }
  ],
